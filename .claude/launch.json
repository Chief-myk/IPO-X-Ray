{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "decide-backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "--app-dir",
        "backend",
        "main:app",
        "--port",
        "8011"
      ],
      "port": 8011
    },
    {
      "name": "decide-frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=8011",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "activity-frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=8012",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    }
  ]
}