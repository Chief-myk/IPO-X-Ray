# --- TinyFish (required for live investigations) ---
TINYFISH_API_KEY=
# Check these two against your TinyFish dashboard / docs and change if they differ
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_RUN_SSE_PATH=/v1/automation/run-sse
# Set to 1 to ask TinyFish for its stealth browser profile (helps on sites with bot checks)
TINYFISH_STEALTH=0

# --- Orchestration ---
MAX_PARALLEL_AGENTS=10
AGENT_TIMEOUT_SECONDS=240
# Where agents start their web searches ({q} is replaced)
SEARCH_URL_TEMPLATE=https://www.bing.com/search?q={q}

# --- Gemini for DRHP claim extraction + report summary ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
